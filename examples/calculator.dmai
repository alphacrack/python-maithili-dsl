कार्य जोड़(अ, ब):
    फेर करू अ + ब

कार्य घटाउ(अ, ब):
    फेर करू अ - ब

कार्य गुणा(अ, ब):
    फेर करू अ * ब

कार्य भाग(अ, ब):
    फेर करू अ / ब

कार्य मुख्य_कैलकुलेटर():
    शीर्षक = "=== मैथिली कैलकुलेटर ==="
    छपाउ(शीर्षक)
    
    संख्या१ = १०
    संख्या२ = ५
    
    जोड़_परिणाम = जोड़(संख्या१, संख्या२)
    जोड़_संदेश = "जोड़ का परिणाम: " + str(जोड़_परिणाम)
    छपाउ(जोड़_संदेश)
    
    घटाउ_परिणाम = घटाउ(संख्या१, संख्या२)
    घटाउ_संदेश = "घटाउ का परिणाम: " + str(घटाउ_परिणाम)
    छपाउ(घटाउ_संदेश)
    
    गुणा_परिणाम = गुणा(संख्या१, संख्या२)
    गुणा_संदेश = "गुणा का परिणाम: " + str(गुणा_परिणाम)
    छपाउ(गुणा_संदेश)
    
    भाग_परिणाम = भाग(संख्या१, संख्या२)
    भाग_संदेश = "भाग का परिणाम: " + str(भाग_परिणाम)
    छपाउ(भाग_संदेश)

कार्य संख्या_तालिका():
    रिक्त_पंक्ति = ""
    छपाउ(रिक्त_पंक्ति)
    शीर्षक = "=== ५ का पहाड़ा ==="
    छपाउ(शीर्षक)
    प्रत्येक i में range(१, ११):
        गुणनफल = ५ * i
        पंक्ति = "५ × " + str(i) + " = " + str(गुणनफल)
        छपाउ(पंक्ति)

मुख्य_कैलकुलेटर()
संख्या_तालिका()
